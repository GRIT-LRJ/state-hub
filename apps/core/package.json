{
  "name": "@state-hub/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "bin": "./dist/main.js",
  "pkg": {
    "assets": [
      "../../node_modules/.pnpm/better-sqlite3@*/node_modules/better-sqlite3/build/Release/better_sqlite3.node"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @state-hub/plugin-kit build && vitest run --exclude \"src/acceptance/**\" --pool=threads --maxWorkers=1",
    "test:acceptance": "pnpm --filter @state-hub/plugin-kit build && node scripts/run-acceptance.mjs",
    "test:performance": "node --import tsx scripts/performance-benchmark.mjs",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@state-hub/domain": "workspace:*",
    "@state-hub/protocol": "workspace:*",
    "@state-hub/sdk": "workspace:*",
    "@napi-rs/keyring": "^1.2.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^12.2.0",
    "fastify": "^5.5.0",
    "@state-hub/plugin-kit": "workspace:*"
  },
  "optionalDependencies": {
    "node-hid": "^3.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "tsx": "^4.20.5",
    "fflate": "^0.8.2"
  }
}
