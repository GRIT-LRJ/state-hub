{
  "name": "state-hub",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "build:sidecar": "node tools/prepare-sidecar.mjs",
    "check": "pnpm -r --if-present check",
    "test": "pnpm --filter @state-hub/protocol build && pnpm --filter @state-hub/domain build && pnpm -r --if-present test",
    "test:acceptance": "pnpm --filter @state-hub/core test:acceptance",
    "verify": "pnpm test && pnpm test:acceptance && pnpm check && pnpm build",
    "dev:core": "pnpm --filter @state-hub/core dev",
    "dev:desktop": "pnpm --filter @state-hub/desktop dev"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@yao-pkg/pkg": "^6.22.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild", "node-hid"]
  }
}
