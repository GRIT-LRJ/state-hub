{
  "name": "state-hub",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm install --frozen-lockfile && pnpm build:sidecar && pnpm --filter @state-hub/desktop tauri dev",
    "build": "pnpm -r --if-present build",
    "build:packages": "pnpm --filter \"./packages/**\" -r build",
    "build:sidecar": "node tools/prepare-sidecar.mjs",
    "check": "pnpm -r --if-present check",
    "test": "pnpm build:packages && node --test tools/performance-policy.test.mjs && pnpm -r --if-present test",
    "test:acceptance": "pnpm build:packages && pnpm --filter @state-hub/core test:acceptance && pnpm --filter @state-hub/desktop test:acceptance",
    "test:performance": "pnpm build:packages && pnpm --filter @state-hub/core test:performance",
    "test:release": "node --test tools/release/*.test.mjs",
    "test:driver-startup": "pnpm --filter @state-hub/core test:driver-startup",
    "test:sidecar": "node tools/release/sidecar-smoke.mjs",
    "prepare:updater-smoke": "node tools/release/prepare-smoke-config.mjs",
    "verify": "pnpm test && pnpm test:acceptance && pnpm check && pnpm build",
    "dev:core": "pnpm --filter @state-hub/core dev",
    "dev:desktop": "pnpm --filter @state-hub/desktop dev"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@yao-pkg/pkg": "^6.22.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild", "node-hid"]
  }
}
